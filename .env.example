# Copie este arquivo para .env e preencha os valores locais.
# O Spring Boot NÃO lê .env automaticamente; exporte as variáveis no SO.

SERVER_PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/gameop
DATABASE_USERNAME=gameop
DATABASE_PASSWORD=altere-esta-senha

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# HS256 — use pelo menos 32 caracteres. Não commite o valor real.
JWT_SECRET=altere-esta-chave-com-pelo-menos-32b
JWT_EXPIRATION_SECONDS=86400

# Twitch / IGDB — nunca commite valores reais
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
